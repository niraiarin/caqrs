# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# uv / venv
.venv/

# IDE
.vscode/
.idea/
*.swp

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Hypothesis
.hypothesis/

# OS
.DS_Store

# Project local data — runtime caches, not the in-tree caqrs.data package
/data/
!src/caqrs/data/
artifacts/runs/
*.parquet
*.sqlite
*.sqlite3

# Secrets
.env
# Catches .env.local, .env.production, dotenvx's decryption-key
# sidecar file, and any future .env-prefixed config that should
# never reach the index.
.env.*
*.pem
*.key
