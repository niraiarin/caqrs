# CAQRS environment variables — placeholder template.
# ----------------------------------------------------
# Copy this file to `.env` (already gitignored) and fill in real values:
#
#     cp env.example .env
#     $EDITOR .env
#
# To auto-load on every command, use dotenvx (https://dotenvx.com):
#
#     dotenvx run -- uv run pytest tests/live/ -v
#     dotenvx run -- uv run python scripts/live_smoke_jquants.py
#     dotenvx run -- uv run python scripts/live_smoke_polymarket_archive.py
#
# Or source manually from your shell:
#
#     set -a; source .env; set +a
#
# To encrypt the file once filled in (so the encrypted form is safe to
# commit and the decryption key lives in .env.keys, gitignored):
#
#     dotenvx encrypt
#
# Polymarket public APIs (CLOB, Gamma, archive.pmxt.dev) are
# unauthenticated; no env var is needed for those clients.

# === Live test gate ==========================================================
# Set to 1 to opt into tests/live/. Live tests touch real LLM endpoints
# / J-Quants / archive.pmxt.dev and are deselected by default.
CAQRS_LIVE=

# === LiteLLM gateway (P1.5 + P1.8 LLM live smoke tests) ======================
# Required for any test that talks to a real LLM through your LiteLLM
# router. Empty model id deselects the LLM live tests in
# tests/live/conftest.py.
CAQRS_LITELLM_MODEL=
# Defaults to http://localhost:11500/v1 if unset.
CAQRS_LITELLM_BASE_URL=
# Defaults to sk-litellm-local if unset.
CAQRS_LITELLM_API_KEY=

# === J-Quants V2 (P1.11.a) ===================================================
# Sign up at https://jpx-jquants.com/ — the free tier covers the two
# endpoints the client currently wraps (/equities/master and
# /equities/bars/daily). Issue an API key from the dashboard.
JQUANTS_API_KEY=

# === Hypothesis profile (optional) ===========================================
# Either 'dev' (default, ~50 examples per property test) or 'ci'
# (~200, deadline disabled). Empty falls through to 'dev'.
HYPOTHESIS_PROFILE=
